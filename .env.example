PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cm_grievance
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1d

# Optional Gemini AI API Key for grievance summary and classification
GEMINI_API_KEY=your_gemini_api_key_here

# Used only by: npm run seed:staff (from backend)
CMO_ADMIN_NAME=CMO Administrator
CMO_ADMIN_EMAIL=admin@example.com
CMO_ADMIN_PASSWORD=replace_with_a_secure_password
OFFICER_NAME=Department Officer
OFFICER_EMAIL=officer@example.com
OFFICER_PASSWORD=replace_with_a_secure_password
OFFICER_DEPARTMENT=Public Works Department
